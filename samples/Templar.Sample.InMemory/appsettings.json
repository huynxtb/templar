{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Templates": {
    "DefaultCulture": "en",
    "EnableCultureFallback": true,
    "EnableCache": true,
    "CacheSeconds": 300,
    "SeedOnStartup": true
  }
}
