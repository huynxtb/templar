{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Templates": {
    "DefaultCulture": "en",
    "EnableCultureFallback": true,
    "EnableCache": true,
    "CacheSeconds": 30,
    "CacheKeyPrefix": "templar:",
    "SeedOnStartup": true,
    "LoopLimit": 1000,
    "Redis": ""
  }
}
