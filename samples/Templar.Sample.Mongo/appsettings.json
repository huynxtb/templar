{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Templates": {
    "ConnectionString": "mongodb://localhost:27017",
    "Database": "notifications",
    "TableName": "notification_templates",
    "DefaultCulture": "en",
    "EnableCultureFallback": true,
    "EnableCache": true,
    "CacheSeconds": 300,
    "SeedOnStartup": true,
    "LoopLimit": 1000
  }
}
