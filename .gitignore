# VS Code — keep the shared files, drop the per-user ones
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json

# Local configuration and secrets. Connection strings belong in user secrets, environment
# variables or a *.Local.json that never leaves the machine — appsettings.json itself is
# committed because it only holds placeholders.
appsettings.*.Local.json
appsettings.Local.json
*.local.json
secrets.json
.env
.env.*

# Claude Code local settings (the shared .claude/settings.json stays tracked)
.claude/settings.local.json

# Operating system noise
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
ehthumbs.db
desktop.ini
*~

artifacts

# Note: samples/Templar.Example/Properties/launchSettings.json is intentionally *not* ignored —
# it pins the sample to http://localhost:5000, which the README documents.
